# Copy to .env.local and fill in. NEXT_PUBLIC_* vars are exposed to the
# browser (Next.js inlines them at build time). Never put a service-role key
# or any LLM API key in this file.

# Server-only (no NEXT_PUBLIC_ prefix), never sent to the browser. Get the
# real value from the Neon console; set it in Vercel project env vars for
# deployed environments, never commit it here.
DATABASE_URL=postgresql://user:password@ep-your-endpoint.neon.tech/neondb?sslmode=require

# Server-only. Used by the public/unauthenticated AI routes
# (app/api/ask-public, app/api/ask-scholar) — those routes gracefully return
# 503 "not configured" until this is set.
GOOGLE_AI_KEY=your-gemini-api-key

# Server-only. The AI brain for signed-in mentor/scholar accounts — used by
# app/api/ask, app/api/ask-budget, and app/api/agent. Those routes gracefully
# return 503 "not configured" until this is set.
ANTHROPIC_API_KEY=your-anthropic-api-key
